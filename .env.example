# ==============================================================================
# OwnMenu Dashboard 环境变量配置示例
# ==============================================================================

# 后端 API 服务地址 (独立部署时配置，如 https://api.ownmenu.com 或后端的 Render 服务地址)
# 本地开发若留空，则默认由 src/setupProxy.js 将 /api 请求代理至 http://localhost:8000
REACT_APP_API_URL=https://api.ownmenu.com

# 生产环境打包时禁用 Source Map 生成（强烈建议设为 false，节省内存、防止 OOM、加快构建速度并保护源码）
GENERATE_SOURCEMAP=false

# 端口号（可选，本地开发端口，默认 3000）
PORT=3000
